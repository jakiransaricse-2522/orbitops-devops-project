---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — OrbitOps"><section class="page-hero wrap"><div class="eyebrow">LET'S CONNECT</div><h1>Tell us what's<br/><em>on your horizon.</em></h1><p class="lead">A new idea, a stubborn bottleneck, or just a question — we're happy to start wherever you are.</p></section><section class="contact-wrap wrap"><div class="contact-note"><h2>Good conversations<br/>make good beginnings.</h2><p>This demo form works locally in your browser and shows a confirmation. Connect it to a backend or form service to receive real submissions.</p><div class="contact-detail"><span>✳</span><div><b>Thoughtful by default</b><small>No pressure, no jargon. Just a useful first conversation.</small></div></div></div><form class="contact-form" id="contact-form"><label>Your name<input name="name" required placeholder="How should we call you?"/></label><label>Work email<input type="email" name="email" required placeholder="you@company.com"/></label><label>What are you working on?<select name="topic"><option>Cloud foundations</option><option>Delivery automation</option><option>Observability & reliability</option><option>Something else</option></select></label><label>A little context<textarea name="message" rows="5" required placeholder="Tell us what's on your mind..."></textarea></label><button class="button primary" type="submit">Send your note ↗</button><p id="form-status" class="form-status" aria-live="polite"></p></form></section><script>
document.querySelector('#contact-form')?.addEventListener('submit',(event)=>{event.preventDefault();const form=event.currentTarget;document.querySelector('#form-status').textContent=`Thanks, ${new FormData(form).get('name')}! This demo form is ready to be connected to a backend.`;form.reset();});
</script></BaseLayout>
