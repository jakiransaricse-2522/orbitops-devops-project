---
import BaseLayout from '../layouts/BaseLayout.astro';
const projects=[['A','Atlas Commerce','A cleaner release path for a growing online marketplace.','DELIVERY AUTOMATION','01'],['N','Northstar Health','Making service health visible across a distributed product team.','OBSERVABILITY','02'],['F','Fieldnote','A flexible cloud foundation for a product finding its pace.','CLOUD FOUNDATIONS','03']];
---
<BaseLayout title="Selected work — OrbitOps"><section class="page-hero wrap"><div class="eyebrow">SELECTED WORK / CONCEPTS</div><h1>Small shifts.<br/><em>Meaningful change.</em></h1><p class="lead">A few fictional examples of the kinds of challenges OrbitOps is designed to help teams solve.</p></section><section class="projects wrap">{projects.map(([letter,name,desc,category,num])=><article class="project"><div class={`project-art art-${num}`}><span>{letter}</span><div class="art-lines"></div><small>CASE STUDY / {num}</small></div><div class="project-info"><span class="eyebrow">{category}</span><h2>{name}</h2><p>{desc}</p></div></article>)}</section><section class="section wrap final-cta"><h2>Your challenge could<br/>be our next <em>case study.</em></h2><a class="button primary" href="/contact">Share your idea ↗</a></section></BaseLayout>
